(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.2)
    (legacy_teardrops no)
  )

  (paper "A4")

  (title_block
    (title "ADR-1 Handheld Controller Board")
    (date "2026-02-27")
    (rev "1.0")
    (company "ADR-1 Project")
    (comment 1 "4-Layer PCB 140mm x 80mm")
    (comment 2 "50Ω impedance controlled")
  )

  ;; 4-Layer Stack-up Definition
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND Plane")
    (2 "In2.Cu" signal "Power 3V3")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user "B.Mask")
    (39 "F.Mask" user "F.Mask")
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user "B.Fabrication")
    (49 "F.Fab" user "F.Fabrication")
  )

  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 1" (type "prepreg") (thickness 0.12) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In1.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 2" (type "core") (thickness 0.8) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In2.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 3" (type "prepreg") (thickness 0.12) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG")
      (dielectric_constraints yes)
    )
    (pad_to_mask_clearance 0.05)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "VBAT")
  (net 4 "VUSB")
  (net 5 "SPI_LORA_SCK")
  (net 6 "SPI_LORA_MISO")
  (net 7 "SPI_LORA_MOSI")
  (net 8 "LORA_NSS")
  (net 9 "LORA_DIO0")
  (net 10 "LORA_RST")
  (net 11 "SPI_DISP_SCK")
  (net 12 "SPI_DISP_MOSI")
  (net 13 "DISP_DC")
  (net 14 "DISP_CS")
  (net 15 "DISP_RST")
  (net 16 "DISP_BL")
  (net 17 "GNSS_TX")
  (net 18 "GNSS_RX")
  (net 19 "GNSS_PPS")
  (net 20 "JOY_L_X")
  (net 21 "JOY_L_Y")
  (net 22 "JOY_R_X")
  (net 23 "JOY_R_Y")
  (net 24 "I2C_SDA")
  (net 25 "I2C_SCL")
  (net 26 "WS2812_DATA")
  (net 27 "BUZZER_PWM")
  (net 28 "USB_DM")
  (net 29 "USB_DP")
  (net 30 "VBAT_ADC")
  (net 31 "SD_CS")
  (net 32 "ESTOP")

  ;; Board Outline (140mm × 80mm ergonomic handheld shape)
  ;; Rounded rectangle with grip cutouts
  (gr_rect (start 0 0) (end 140 80)
    (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))

  ;; Mounting Holes (M2.5)
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (at 5 5) (layer "F.Cu")
    (property "Reference" "MH1" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.4 5.4) (drill 2.7) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (at 135 5) (layer "F.Cu")
    (property "Reference" "MH2" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.4 5.4) (drill 2.7) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (at 5 75) (layer "F.Cu")
    (property "Reference" "MH3" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.4 5.4) (drill 2.7) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (at 135 75) (layer "F.Cu")
    (property "Reference" "MH4" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 5.4 5.4) (drill 2.7) (layers "*.Cu" "*.Mask") (net 1))
  )

  ;; Board Title
  (gr_text "ADR-1 CONTROLLER v1.0" (at 70 3) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2) bold)))

  ;; Component Grade: ALL ICs Industrial (-40°C to +85°C) or better
  ;; Display: NHD-3.5-320240MF-ATXI#-1 (Industrial -30°C to +80°C)
  ;; LEDs: APA102-2020 (Industrial -40°C to +85°C, replaces WS2812B)
  ;; Charger: MCP73871-2CCI only (TP4056 removed)

  ;; LoRa Antenna Keep-Out Zone (bottom edge, 40×15mm)
  (gr_rect (start 50 65) (end 90 80)
    (stroke (width 0.2) (type dash)) (fill none) (layer "Dwgs.User"))
  (gr_text "ANTENNA KEEP-OUT" (at 70 62) (layer "Dwgs.User")
    (effects (font (size 1 1) (thickness 0.15))))

  ;; GND Plane - In1.Cu (full ground)
  (zone (net 1) (net_name "GND") (layer "In1.Cu") (uuid "ctrl-zone-gnd")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 140 0) (xy 140 80) (xy 0 80)))
  )

  ;; +3V3 Plane - In2.Cu
  (zone (net 2) (net_name "+3V3") (layer "In2.Cu") (uuid "ctrl-zone-3v3")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 140 0) (xy 140 80) (xy 0 80)))
  )

  ;; GND Pour - F.Cu
  (zone (net 1) (net_name "GND") (layer "F.Cu") (uuid "ctrl-zone-gnd-top")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 140 0) (xy 140 80) (xy 0 80)))
  )

  ;; GND Pour - B.Cu
  (zone (net 1) (net_name "GND") (layer "B.Cu") (uuid "ctrl-zone-gnd-bot")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 140 0) (xy 140 80) (xy 0 80)))
  )

  ;; Ground cutout under LoRa antenna (In1.Cu)
  ;; Required for PCB trace antenna performance
  (zone (net 0) (net_name "") (layer "In1.Cu") (uuid "ctrl-ant-cutout")
    (hatch edge 0.5)
    (connect_pads (clearance 0))
    (min_thickness 0.2)
    (fill no)
    (keepout (tracks not_allowed) (vias not_allowed) (pads not_allowed)
             (copperpour not_allowed) (footprints not_allowed))
    (polygon (pts (xy 50 65) (xy 90 65) (xy 90 80) (xy 50 80)))
  )

  ;; Component Placement Labels
  (gr_text "ESP32-S3" (at 40 30) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "DISPLAY FPC" (at 20 40) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "SX1276" (at 100 30) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "GNSS" (at 120 30) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "JOY-L" (at 20 60) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "JOY-R" (at 120 60) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "USB-C" (at 70 77) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15))))
  (gr_text "BATTERY" (at 70 55) (layer "B.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
)
