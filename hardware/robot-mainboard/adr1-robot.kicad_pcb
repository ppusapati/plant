(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )

  (paper "A4")

  (title_block
    (title "ADR-1 Robot Main Board")
    (date "2026-02-27")
    (rev "1.0")
    (company "ADR-1 Project")
    (comment 1 "6-Layer PCB 150mm x 120mm")
    (comment 2 "Impedance: 50Ω SE, 100Ω Diff")
  )

  ;; 6-Layer Stack-up Definition
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND Plane")
    (2 "In2.Cu" signal "Signal")
    (3 "In3.Cu" signal "Power Planes")
    (4 "In4.Cu" signal "GND Plane")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user "B.Mask")
    (39 "F.Mask" user "F.Mask")
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user "B.Fabrication")
    (49 "F.Fab" user "F.Fabrication")
  )

  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 1" (type "prepreg") (thickness 0.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In1.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 2" (type "core") (thickness 0.3) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In2.Cu" (type "copper") (thickness 0.0175) (material "Cu"))
      (layer "dielectric 3" (type "prepreg") (thickness 0.12) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In3.Cu" (type "copper") (thickness 0.0175) (material "Cu"))
      (layer "dielectric 4" (type "core") (thickness 0.3) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In4.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "dielectric 5" (type "prepreg") (thickness 0.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035) (material "Cu"))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG")
      (dielectric_constraints yes)
    )
    (pad_to_mask_clearance 0.05)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+5V")
  (net 4 "+24V")
  (net 5 "+12V")
  (net 6 "SPI1_SCK")
  (net 7 "SPI1_MISO")
  (net 8 "SPI1_MOSI")
  (net 9 "LORA_NSS")
  (net 10 "LORA_DIO0")
  (net 11 "LORA_RST")
  (net 12 "UART1_TX")
  (net 13 "UART1_RX")
  (net 14 "GNSS_PPS")
  (net 15 "I2C1_SDA")
  (net 16 "I2C1_SCL")
  (net 17 "UART2_TX")
  (net 18 "UART2_RX")
  (net 19 "RS485_DE")
  (net 20 "CAN_TX")
  (net 21 "CAN_RX")
  (net 22 "CAN_H")
  (net 23 "CAN_L")
  (net 24 "RS485_A")
  (net 25 "RS485_B")
  (net 26 "UART3_TX")
  (net 27 "UART3_RX")
  (net 28 "USB_DM")
  (net 29 "USB_DP")
  (net 30 "SWDIO")
  (net 31 "SWCLK")
  (net 32 "SWO")
  (net 33 "NRST")
  (net 34 "VBAT_SENSE")

  ;; Board Outline (150mm × 120mm with rounded corners)
  (gr_rect (start 0 0) (end 150 120)
    (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))

  ;; Mounting Holes (M3, 4 corners)
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad_Via" (at 5 5) (layer "F.Cu")
    (property "Reference" "MH1" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 6.2 6.2) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad_Via" (at 145 5) (layer "F.Cu")
    (property "Reference" "MH2" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 6.2 6.2) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad_Via" (at 5 115) (layer "F.Cu")
    (property "Reference" "MH3" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 6.2 6.2) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad_Via" (at 145 115) (layer "F.Cu")
    (property "Reference" "MH4" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole circle (at 0 0) (size 6.2 6.2) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )

  ;; Board Title Silkscreen
  (gr_text "ADR-1 ROBOT v1.0" (at 75 3) (layer "F.SilkS")
    (effects (font (size 2 2) (thickness 0.3) bold)))

  ;; GND Zone - Layer In1.Cu (full ground plane)
  (zone (net 1) (net_name "GND") (layer "In1.Cu") (uuid "zone-gnd-in1")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 150 0) (xy 150 120) (xy 0 120)))
  )

  ;; GND Zone - Layer In4.Cu (full ground plane)
  (zone (net 1) (net_name "GND") (layer "In4.Cu") (uuid "zone-gnd-in4")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 150 0) (xy 150 120) (xy 0 120)))
  )

  ;; +3V3 Zone - Layer In3.Cu (left half of power plane)
  (zone (net 2) (net_name "+3V3") (layer "In3.Cu") (uuid "zone-3v3")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 75 0) (xy 75 120) (xy 0 120)))
  )

  ;; +5V Zone - Layer In3.Cu (right half of power plane)
  (zone (net 3) (net_name "+5V") (layer "In3.Cu") (uuid "zone-5v")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 76 0) (xy 150 0) (xy 150 120) (xy 76 120)))
  )

  ;; GND Zone - F.Cu (pour around components)
  (zone (net 1) (net_name "GND") (layer "F.Cu") (uuid "zone-gnd-top")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 150 0) (xy 150 120) (xy 0 120)))
  )

  ;; GND Zone - B.Cu (pour around components)
  (zone (net 1) (net_name "GND") (layer "B.Cu") (uuid "zone-gnd-bot")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 150 0) (xy 150 120) (xy 0 120)))
  )

  ;; Component Placement Annotations (silkscreen guides)
  (gr_text "STM32H743" (at 50 50) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "ESP32-S3" (at 110 50) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "SX1276 LoRa" (at 50 20) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "NEO-M9N GNSS" (at 110 20) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "POWER" (at 75 100) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "CAN/RS485" (at 130 80) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2))))

  ;; Component Grade: ALL ICs Industrial (-40°C to +85°C) or better
  ;; SDRAM: IS42S16400J-7TLI (Industrial)
  ;; 12V Buck: TPS54360BDDAR (Industrial, replaces XL4015)
  ;; Ultrasonic: MB1240 XL-MaxSonar-EZ4 (Industrial, IP67, replaces HC-SR04)
  ;; Camera: AR0234CS (Automotive -40°C to +105°C, replaces OV5640)
  ;; LiDAR: TFmini-S-I (Industrial, replaces TFmini-S)
  ;; Encoder: AS5047P (AEC-Q100 -40°C to +125°C, replaces E6B2-CWZ6C)
  ;;
  ;; Design Rules
  ;; Min trace width: 0.15mm (signal), 0.3mm (power)
  ;; Min clearance: 0.15mm
  ;; Min via: 0.3mm drill, 0.6mm pad
  ;; Impedance controlled: 50Ω single-ended (0.18mm trace on layers 0,31)
  ;; Differential pairs: 100Ω (0.15mm trace, 0.15mm gap)
)
